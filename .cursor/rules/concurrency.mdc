## Continuations

Bridge callback-based APIs to async/await:

```swift
// Checked continuation (throws on misuse)
func legacyFetch() async throws -> Data {
    try await withCheckedThrowingContinuation { continuation in
        legacyAPI.fetch { result in
            switch result {
            case .success(let data):
                continuation.resume(returning: data)
            case .failure(let error):
                continuation.resume(throwing: error)
            }
        }
    }
}

// Unsafe continuation (better performance, no safety checks)
func legacyFetchUnsafe() async throws -> Data {
    try await withUnsafeThrowingContinuation { continuation in
        legacyAPI.fetch { result in
            switch result {
            case .success(let data):
                continuation.resume(returning: data)
            case .failure(let error):
                continuation.resume(throwing: error)
            }
        }
    }
}
```

## Actor Isolation

Understand actor isolation:

```swift
actor DataStore {
    private var data: [String: Any] = [:]
    
    // Isolated to actor (async access required)
    func get(key: String) -> Any? {
        data[key]
    }
    
    // Isolated to actor
    func set(key: String, value: Any) {
        data[key] = value
    }
    
    // Non-isolated (can be called synchronously)
    nonisolated func description() -> String {
        "DataStore"
    }
}

// Usage
let store = DataStore()

// Async access required
Task {
    await store.set(key: "name", value: "John")
    let value = await store.get(key: "name")
}

// Synchronous access allowed
let desc = store.description()
```

## Sendable Protocol

Ensure types are safe to send across concurrency boundaries:

```swift
// Struct is automatically Sendable (value type)
struct User: Sendable {
    let id: String
    let name: String
}

// Class must be explicitly marked and meet requirements
final class ImmutableConfig: Sendable {
    let apiKey: String
    let baseURL: URL
    
    init(apiKey: String, baseURL: URL) {
        self.apiKey = apiKey
        self.baseURL = baseURL
    }
}

// Actor is implicitly Sendable
actor UserCache: Sendable {
    private var users: [String: User] = [:]
}

// Non-Sendable type (mutable class)
class MutableState {
    var value: Int = 0
}

// Compiler error: cannot send non-Sendable type
func badExample() {
    let state = MutableState()
    Task {
        // Error: MutableState is not Sendable
        state.value = 42
    }
}
```

## Common Patterns

### Service with Actor

```swift
actor NetworkService {
    private let session: URLSession
    private var cache: [URL: Data] = [:]
    
    init(session: URLSession = .shared) {
        self.session = session
    }
    
    func fetch(from url: URL, useCache: Bool = true) async throws -> Data {
        if useCache, let cached = cache[url] {
            return cached
        }
        
        let (data, _) = try await session.data(from: url)
        cache[url] = data
        return data
    }
    
    func clearCache() {
        cache.removeAll()
    }
}
```

### ViewModel with MainActor

```swift
@MainActor
class ListViewModel: ObservableObject {
    @Published var items: [Item] = []
    @Published var isLoading = false
    @Published var error: Error?
    
    private let service: ItemService
    
    init(service: ItemService) {
        self.service = service
    }
    
    func loadItems() async {
        isLoading = true
        defer { isLoading = false }
        
        do {
            items = try await service.fetchItems()
            error = nil
        } catch {
            self.error = error
        }
    }
    
    func deleteItem(_ item: Item) async {
        do {
            try await service.delete(item)
            items.removeAll { $0.id == item.id }
        } catch {
            self.error = error
        }
    }
}
```

### Debounced Search

```swift
@MainActor
class SearchViewModel: ObservableObject {
    @Published var searchText = ""
    @Published var results: [Result] = []
    
    private var searchTask: Task<Void, Never>?
    
    func search() {
        // Cancel previous search
        searchTask?.cancel()
        
        // Debounce
        searchTask = Task {
            try? await Task.sleep(nanoseconds: 300_000_000)
            
            guard !Task.isCancelled else { return }
            
            do {
                results = try await performSearch(searchText)
            } catch {
                print("Search failed: \(error)")
            }
        }
    }
    
    private func performSearch(_ query: String) async throws -> [Result] {
        // Actual search implementation
    }
}
```

## Performance Tips

```swift
// Use async let for concurrent operations
func loadDashboard() async throws -> Dashboard {
    async let user = fetchUser()
    async let stats = fetchStats()
    async let notifications = fetchNotifications()
    
    return try await Dashboard(
        user: user,
        stats: stats,
        notifications: notifications
    )
}

// Avoid unnecessary await
actor Counter {
    private var value = 0
    
    // Good: Single await
    func incrementAndGet() -> Int {
        value += 1
        return value
    }
    
    // Bad: Multiple awaits for same actor
    func badIncrement() async -> Int {
        await increment()
        return await getValue()
    }
}

// Use nonisolated for pure functions
actor Calculator {
    nonisolated func add(_ a: Int, _ b: Int) -> Int {
        a + b  // No await needed
    }
}
```

## Testing Async Code

```swift
final class ServiceTests: XCTestCase {
    func testFetchData() async throws {
        let service = DataService()
        let data = try await service.fetchData()
        XCTAssertFalse(data.isEmpty)
    }
    
    func testCancellation() async throws {
        let task = Task {
            try await longRunningOperation()
        }
        
        task.cancel()
        
        do {
            _ = try await task.value
            XCTFail("Should have been cancelled")
        } catch is CancellationError {
            // Expected
        }
    }
}
```
