# Swift Concurrency Patterns

## Async/Await Basics

Use async/await for asynchronous operations:

```swift
// Async function
func fetchData() async throws -> Data {
    let url = URL(string: "https://api.example.com/data")!
    let (data, _) = try await URLSession.shared.data(from: url)
    return data
}

// Calling async functions
func loadData() async {
    do {
        let data = try await fetchData()
        print("Loaded \(data.count) bytes")
    } catch {
        print("Error: \(error)")
    }
}

// Multiple concurrent operations
func loadMultipleResources() async throws -> (Data, Data, Data) {
    async let data1 = fetchData(from: url1)
    async let data2 = fetchData(from: url2)
    async let data3 = fetchData(from: url3)
    
    return try await (data1, data2, data3)
}
```

**Guidelines:**
- Prefer async/await over completion handlers
- Use `async let` for concurrent operations
- Mark throwing functions with `async throws`
- Avoid blocking the thread with synchronous code

## Actors for Thread Safety

Use actors to protect mutable state:

```swift
actor ChatService {
    // MARK: - Properties (automatically protected)
    private var cache: [String: Chat] = [:]
    private var activeRequests: Set<String> = []
    
    // MARK: - Public API
    
    func getChat(id: String) async throws -> Chat {
        // Check cache first
        if let cached = cache[id] {
            return cached
        }
        
        // Prevent duplicate requests
        guard !activeRequests.contains(id) else {
            // Wait and retry
            try await Task.sleep(nanoseconds: 100_000_000)
            return try await getChat(id: id)
        }
        
        activeRequests.insert(id)
        defer { activeRequests.remove(id) }
        
        // Fetch from database
        let chat = try await fetchFromDatabase(id: id)
        cache[id] = chat
        return chat
    }
    
    func invalidateCache() {
        cache.removeAll()
    }
    
    // MARK: - Private Implementation
    
    private func fetchFromDatabase(id: String) async throws -> Chat {
        // Database access
    }
}
```

**Actor Benefits:**
- Automatic synchronization of mutable state
- No need for locks or semaphores
- Compiler-enforced thread safety
- Async access to properties and methods

## MainActor for UI Updates

Use @MainActor for UI-related code:

```swift
@MainActor
class ChatViewModel: ObservableObject {
    // All properties and methods run on main thread
    @Published var messages: [Message] = []
    @Published var isLoading = false
    @Published var error: Error?
    
    private let chatService: ChatService
    
    init(chatService: ChatService) {
        self.chatService = chatService
    }
    
    func loadMessages() async {
        isLoading = true
        defer { isLoading = false }
        
        do {
            // Service call happens off main thread
            let chat = try await chatService.getChat(id: chatId)
            
            // Assignment happens on main thread (automatic)
            messages = chat.messages
            error = nil
        } catch {
            self.error = error
        }
    }
    
    // Explicitly run on main thread
    @MainActor
    func updateUI() {
        // UI updates
    }
}

// Call from background
Task {
    await viewModel.loadMessages()  // Automatically switches to main thread
}
```

**MainActor Guidelines:**
- Mark ViewModels with `@MainActor`
- All `@Published` properties should be on MainActor
- SwiftUI views are implicitly `@MainActor`
- Use for any UI-related code

## Task Management

Manage async tasks properly:

```swift
struct ContentView: View {
    @State private var data: Data?
    @State private var loadTask: Task<Void, Never>?
    
    var body: some View {
        Text("Content")
            .task {
                // Automatically cancelled when view disappears
                await loadData()
            }
            .onDisappear {
                // Manual cancellation if needed
                loadTask?.cancel()
            }
    }
    
    func loadData() async {
        do {
            data = try await fetchData()
        } catch {
            print("Error: \(error)")
        }
    }
}

// Creating tasks manually
func startBackgroundWork() {
    Task {
        await doWork()
    }
    
    // With priority
    Task(priority: .background) {
        await doBackgroundWork()
    }
    
    // Detached task (doesn't inherit context)
    Task.detached {
        await doIndependentWork()
    }
}
```

## Task Cancellation

Handle task cancellation:

```swift
func processLargeDataset() async throws {
    for item in largeDataset {
        // Check for cancellation
        try Task.checkCancellation()
        
        // Or use isCancelled
        guard !Task.isCancelled else {
            throw CancellationError()
        }
        
        await processItem(item)
    }
}

// Cancellable operation
func fetchWithTimeout() async throws -> Data {
    try await withThrowingTaskGroup(of: Data.self) { group in
        // Add fetch task
        group.addTask {
            try await fetchData()
        }
        
        // Add timeout task
        group.addTask {
            try await Task.sleep(nanoseconds: 5_000_000_000)
            throw TimeoutError()
        }
        
        // Return first result
        let result = try await group.next()!
        group.cancelAll()
        return result
    }
}
```

## Task Groups

Use task groups for structured concurrency:

```swift
func processFiles(_ files: [URL]) async throws -> [ProcessedFile] {
    try await withThrowingTaskGroup(of: ProcessedFile.self) { group in
        // Add tasks for each file
        for file in files {
            group.addTask {
                try await processFile(file)
            }
        }
        
        // Collect results
        var results: [ProcessedFile] = []
        for try await result in group {
            results.append(result)
        }
        return results
    }
}

// With limited concurrency
func processFilesWithLimit(_ files: [URL], maxConcurrent: Int) async throws -> [ProcessedFile] {
    try await withThrowingTaskGroup(of: ProcessedFile.self) { group in
        var results: [ProcessedFile] = []
        var index = 0
        
        // Start initial batch
        for _ in 0..<min(maxConcurrent, files.count) {
            group.addTask {
                try await processFile(files[index])
            }
            index += 1
        }
        
        // Process results and add new tasks
        for try await result in group {
            results.append(result)
            
            if index < files.count {
                group.addTask {
                    try await processFile(files[index])
                }
                index += 1
            }
        }
        
        return results
    }
}
```

## AsyncSequence

Work with async sequences:

```swift
// Consuming async sequence
func processStream() async throws {
    let stream = URLSession.shared.bytes(from: url)
    
    for try await byte in stream.0 {
